generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  books Book[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  author      String
  description String
  price       Int      // stored in cents
  stock       Int      @default(0)
  isbn        String?
  year        Int?
  createdAt   DateTime @default(now())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}
